# Copy to .env and fill in the two required values. They are left EMPTY on
# purpose: compose refuses to start on a blank one, and a placeholder address
# would start an SFU that looks healthy while nobody can hear anything.

# The public address of THIS server. mediasoup announces it to browsers as the
# address to send media to, so it must be the public IP, not a private or
# docker one. Getting this wrong is the classic "call connects, then silence".
#   example: 203.0.113.30
PUBLIC_IP=

# DNS name for this SFU, pointing at PUBLIC_IP. Caddy gets a certificate for
# it, and the app connects to wss://<this>/sfu.
#
# Keep it DNS-only rather than behind a CDN proxy: only the signalling
# WebSocket would be proxied anyway (media goes direct), so a proxy adds a hop
# and an idle timeout for no benefit.
#   example: sfu-us.example.com
SFU_HOSTNAME=

# ── Optional ─────────────────────────────────────────────────────────────────

# Media port range, published udp AND tcp, and open in the firewall.
#
# The default starts at 61000, above Linux's ephemeral range (32768-60999).
# Keep it there: docker binds every port at container start and one port
# already in use aborts the whole container, so a range inside the ephemeral
# window makes the SFU fail to start at random after a reboot. If you must use
# a lower range, reserve it first:
#   sysctl -w net.ipv4.ip_local_reserved_ports=40000-40499
#
# Capacity: mediasoup keeps separate UDP and TCP pools, so an N-port range
# allows N transports, and a participant in a call holds two (send + recv).
# 500 ports is therefore about 250 concurrent video participants.
#
# Width costs memory unless the docker userland proxy is off - see the note at
# the top of docker-compose.yml. Do that before the first `up`.
#SFU_RTC_MIN_PORT=61000
#SFU_RTC_MAX_PORT=61499

# Rooms allowed to hold a live mediasoup router here. Counts ROOMS, not
# participants, so it is not the capacity ceiling - the port range above is.
#SFU_MAX_ROOMS=250
