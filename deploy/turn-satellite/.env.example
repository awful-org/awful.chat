# Copy to .env and fill in the three required values. They are left EMPTY on
# purpose: compose refuses to start on a blank one, which is better than
# starting with a placeholder that looks fine and serves nobody.

# The public address of THIS server. coturn hands it to clients as the relay
# address, so it has to be reachable from the internet, not a private IP.
#
# coturn runs on the host network stack (network_mode: host in the compose
# file), so anything bound to 0.0.0.0 on this machine - an admin UI, an
# exporter, a database - would be reachable through TURN if not explicitly
# denied. The compose file denies your PUBLIC_IP as a peer address to close
# that hole.
#   example: 203.0.113.20
PUBLIC_IP=

# A hostname resolving to PUBLIC_IP. Used as the TURN realm, and it is what
# goes into the main instance's TURN_URLS.
#
# It must be DNS-only. TURN is UDP and raw TCP, which CDN proxies (Cloudflare
# and friends) do not forward at all - a proxied hostname gives you a TURN
# server that can never be reached.
#   example: turn-us.example.com
PUBLIC_HOSTNAME=

# The SAME value as TURN_SECRET on the main instance. This is the only thing
# the two servers share: the relay mints a short-lived HMAC credential and
# this coturn verifies it with the same secret. No connection between the
# machines is needed, in either direction.
#
# Generate it shell-safe:  openssl rand -hex 32
# The coturn image's entrypoint runs the arguments through `eval`, so a secret
# containing $, backticks, * or whitespace is silently REWRITTEN before coturn
# sees it - byte-identical secrets on both machines, every credential
# rejected, and nothing in any log saying why.
TURN_SECRET=

# Both servers must also agree on the time to within the credential's 12 hour
# lifetime: the username IS an expiry timestamp, which coturn compares to its
# own clock. Any working NTP setup is enough.

# ── Optional ─────────────────────────────────────────────────────────────────

#TURN_REALM=

# Relay ports: one per allocation, and a browser holds about two per TURN
# server, so this is the real ceiling on concurrent relayed peers.
#TURN_MIN_PORT=49152
#TURN_MAX_PORT=50151

# Concurrent allocations for the whole server. This is the cap that matters.
#TURN_TOTAL_QUOTA=300

# Per-username, and with this credential scheme a username is an expiry
# TIMESTAMP shared by everyone who asked in the same second - so it does not
# bound one client, and raising it is usually not what you want. Left in place
# to stop a single second's worth of clients running away with the server.
#TURN_USER_QUOTA=12

# ── TURN over TLS ────────────────────────────────────────────────────────────
# turns: on 5349 is what gets through restrictive mobile carriers. Without it
# those users may have no working transport at all.
#
# Point TURN_TLS_DIR at the WHOLE letsencrypt tree, not at live/<host>:
# everything under live/ is a relative symlink into ../../archive/, so
# mounting live/ alone leaves the real files outside the container and coturn
# reports the certificate as missing.
#
# The image runs as uid 65534 (nobody), while certbot writes privkey.pem 0600
# root:root inside 0700 directories, so the key must be made readable - a
# renewal hook doing chgrp/chmod 0640, or run the service as root. Check it
# took with: docker compose logs | grep -i 'Certificate file found'
#
# Then open 5349/tcp in the firewall AND append the turns: URL to TURN_URLS on
# the main instance - a listener nobody is told about serves nobody:
#   turns:<PUBLIC_HOSTNAME>:5349?transport=tcp
# The certificate name has to match PUBLIC_HOSTNAME; turns: is name-validated.
#TURN_TLS_DIR=/etc/letsencrypt
#TURN_TLS_ARGS=--cert=/certs/live/turn-us.example.com/fullchain.pem --pkey=/certs/live/turn-us.example.com/privkey.pem
