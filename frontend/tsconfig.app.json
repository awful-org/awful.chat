{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "types": ["svelte", "vite/client"],
    "noEmit": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  // The built-in plugins too. They are first-party code that ships in the
  // bundle, and leaving them out meant their type errors were invisible -
  // poll and wheel both used HostApi without importing it and nothing ever
  // said so.
  //
  // Named one by one rather than plugins/**: fetched PLUGIN_SOURCES plugins
  // live in that same folder, and this repo's gate must not turn red for
  // somebody else's code. A new built-in adds a line here, next to adding
  // its folder.
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "plugins/ping/**/*.ts",
    "plugins/ping/**/*.svelte",
    "plugins/poll/**/*.ts",
    "plugins/poll/**/*.svelte",
    "plugins/wheel/**/*.ts",
    "plugins/wheel/**/*.svelte",
    "plugins/anime-party/**/*.ts",
    "plugins/anime-party/**/*.svelte"
  ]
}
