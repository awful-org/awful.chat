# Copy to .env and fill in. The README's self-hosting section explains each
# variable; docker-compose.dokploy.yml is what reads them.

# ── Required ─────────────────────────────────────────────────────────────────

# Public domain of the instance (Traefik routes on it).
DOMAIN=example.com

# The server's public IP. The SFU and coturn announce it to clients.
ANNOUNCED_IP=203.0.113.10

# Hostname the relay is served on. Defaults to relay.DOMAIN. Set it when the
# relay lives under another name (a dev-relay.example.com), and point
# VITE_API_URL and VITE_RELAY_MULTIADDR at that same name.
#RELAY_DOMAIN=

# Prefix for this deployment's traefik router, service and middleware names.
# Default "awful". These names are GLOBAL across every compose project behind
# one dokploy, so a second stack that reuses them takes the first one down.
# A second stack on one box must also move its ports: SFU_RTC_MIN_PORT /
# SFU_RTC_MAX_PORT, and TURN_PORT plus TURN_MIN_PORT / TURN_MAX_PORT, since
# coturn is host-network and those are host-wide.
#STACK=

# Relay API origin the frontend calls (/og, /klipy, /turn-credentials,
# /plugin-proxy).
#
# This and the three below are served to the app as /config.json, written by
# the frontend container at start - they are not baked into the bundle. A
# change here needs `docker compose up -d frontend`, not a rebuild.
VITE_API_URL=https://relay.example.com

# The relay's libp2p multiaddr, printed on relay boot.
VITE_RELAY_MULTIADDR=/dns4/relay.example.com/tcp/443/wss/p2p/12D3KooW...

# Shared secret between the relay and coturn. The relay mints a short-lived
# HMAC credential per client (/turn-credentials) and coturn verifies it with
# --use-auth-secret, so no TURN password ships in the JS bundle.
#   openssl rand -hex 32
# Keep it shell-safe: the coturn image's entrypoint runs its arguments through
# `eval`, so a secret containing $, backticks, * or whitespace is rewritten
# before coturn sees it, and every credential is then rejected with nothing in
# any log explaining why.
# Required: coturn will not start without it. Every coturn serving this
# instance (including ones your friends host elsewhere) needs the SAME value.
#
# SECURITY NOTE: coturn receives this secret as a command-line argument
# (--static-auth-secret=${TURN_SECRET}) in deploy/turn-satellite/docker-compose.yml
# and docker-compose.dokploy.yml. It is readable in /proc/<pid>/cmdline by any
# local user on the container host and in `docker inspect` output. If the host
# holds untrusted users, use a dedicated machine or switch coturn to a config
# file (this would be a deployment shape change - see deploy/README.md).
TURN_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────

# SFU websocket URL. Defaults to /sfu on the app origin; dev uses
# http://localhost:3000.
#VITE_SFU_URL=

# MORE THAN ONE SFU. Comma-separated; takes precedence over VITE_SFU_URL.
# A room is placed on ONE of these by hashing its room code, so every
# participant picks the same server with no coordination and no extra round
# trip. It is placement, not load balancing: a room cannot be split across
# SFUs (there is no router cascading), so this spreads ROOMS, and a room is
# only as fast as the server it lands on - put one near each cluster of users.
# Adding a server moves only its share of rooms, and never disturbs a call in
# progress. Each SFU needs its own host, its own ANNOUNCED_IP and its own
# open port range.
#VITE_SFU_URLS=wss://sfu-eu.example.com/sfu,wss://sfu-us.example.com/sfu

# Enables the GIF picker (klipy.co API key).
#KLIPY_API_KEY=

# Plugins fetched at build time; see frontend/plugins/README.md.
# Comma-separated GitHub repos pinned to a commit: owner/repo@sha.
#
# An instance that sets this ships code CI does not build, so no published
# build hash will describe it. It stays checkable by rebuilding - see
# awful-verify - which reads the plugin list out of the instance's own
# build declaration.
#
# USE @, NOT #. A .env file treats # as the start of a comment, so
# PLUGIN_SOURCES=owner/repo#sha arrives at the build as owner/repo - pinned
# where you wrote it, unpinned by the time anything reads it, and the build
# then fails complaining about a pin that is visibly right there. Both
# separators work everywhere else.
#
# An unpinned entry fails the build unless PLUGIN_SOURCES_ALLOW_UNPINNED=1,
# and an unpinned deploy cannot be rebuilt by anyone once that branch moves.
#PLUGIN_SOURCES=

# Fetch a plugin source that names no commit. Off by default, and it should
# stay off: an unpinned source can ship different code on the next build with
# no diff to review, and plugins compile into the bundle. "1" allows it.
#PLUGIN_SOURCES_ALLOW_UNPINNED=awful-org/awfully-awesome@d00d9db

# Hostnames plugins may reach through the relay's /plugin-proxy, and
# through /plugin-stream, which streams media (HLS playlists and segments)
# from the same list instead of buffering it.
#PLUGIN_PROXY_HOSTS=api.steampowered.com,store.steampowered.com

# NAME@host?param=value list. A plugin puts {{secret:NAME}} as the whole
# value of that query parameter, and the relay substitutes it server-side
# only on that host and only into that parameter - so a caller cannot send
# the key to another host or move it into a parameter the upstream echoes.
#
# Optional hardening: NAME@host/path/prefix?param=value also restricts the
# path, for a host that serves some endpoint which echoes its query back.
# A prefix ending in "/" matches everything below it.
#
# Each NAME holds ONE binding: a second entry with the same NAME replaces the
# first. A plugin that calls several path prefixes on its host with the same
# key should leave the path out rather than list one entry per prefix.
#
# The older NAME@host=value and NAME=value forms are no longer substituted,
# and the relay names any it finds at boot.
#PLUGIN_PROXY_SECRETS=STEAM@api.steampowered.com?key=your-steam-api-key

# Whose X-Forwarded-For the relay believes: a comma list of CIDRs, bare
# addresses and hostnames. Every per-client limit the relay has
# (/turn-credentials, /invite, /mailbox, /push, /og, /plugin-proxy,
# /plugin-stream, /telemetry) keys on the address this yields.
#
# Empty means trust NOTHING: X-Forwarded-For is ignored and every request is
# keyed on its socket peer - right for a relay reached directly, and wrong
# behind a proxy, where every user then shares the proxy's one bucket. The
# relay logs a hint the first time it sees a private address forwarding for
# someone it does not trust.
#
# The dokploy compose defaults this to "dokploy-traefik", the name of
# Dokploy's Traefik container. A hostname is re-resolved every 30 seconds, so
# it keeps working when Traefik is recreated with a new address, which a
# written-down /32 does not. Name your own proxy instead if it is called
# something else, and add a CDN's published ranges when one sits in front of
# it. "private" trusts every private and loopback range - the old default,
# which lets any container on the same docker network forge the header.
#TRUSTED_PROXY_CIDRS=dokploy-traefik,173.245.48.0/20

# MORE THAN ONE TURN SERVER. Comma-separated, served to clients as-is.
# Unlike the SFU there is nothing to place: ICE gathers a candidate from every
# entry at once and picks whichever actually connects, fastest first, so a
# second server near a group of users genuinely improves their connect time
# and their relayed latency. Each one runs coturn with the SAME TURN_SECRET;
# nothing else is shared, so a friend can host one on their own VPS.
#TURN_URLS=turn:turn-eu.example.com:3478?transport=udp,turn:turn-us.example.com:3478?transport=udp

# Hostname the default TURN URLs are built from when TURN_URLS is unset.
# Defaults to DOMAIN. Set it when the app domain sits behind a CDN: TURN is
# UDP (and raw TCP), which proxies like Cloudflare do not forward, so the
# TURN hostname has to resolve straight to the machine running coturn.
#TURN_HOST=turn.example.com

# TURN realm. Defaults to DOMAIN.
#TURN_REALM=

# Running more than one stack on one host: every service name is also a DNS
# alias on whatever network it joins, so two stacks that share a network both
# answer to "sfu", "relay" and so on. Docker returns all of them and rotates,
# which splits a single call across two SFUs and shows as empty video tiles
# while voice keeps working. The compose keeps the SFU on a per-project
# network for that reason. If you add a service the frontend reaches BY NAME,
# put it on `internal` too rather than on dokploy-network.

# The two ports coturn LISTENS on. Both matter when a host runs more than one
# stack: coturn is network_mode: host, so these are host-wide, and a second
# stack that leaves either at its default collides with the first. The loser
# does not start, and the symptom is remote and confusing - its relay keeps
# minting credentials, they reach whichever coturn DID bind the port, and that
# one rejects them with 401 because they were signed with another secret.
# Move BOTH for a second stack, not just TURN_PORT.
#TURN_PORT=3478
#TURN_ALT_PORT=5349

# TURN over TLS: certificate directory and the extra coturn args enabling it.
# turns: on 5349 is what gets through restrictive mobile carriers. Without a
# certificate those users have no working TURN transport at all.
#TURN_TLS_DIR=
#TURN_TLS_ARGS=--cert=/certs/fullchain.pem --pkey=/certs/privkey.pem

# ── Telemetry (optional, off by default) ─────────────────────────────────────

# The diagnostic collector on the relay. "1" makes POST /telemetry accept a
# bundle from a peer that signed it with its own device key, staple the relay's
# own view of that peer, and store it for 7 days. Unset makes the route answer
# 204, store nothing, and the app hides its Upload button.
#
# Turning this on is a real disclosure change: the relay gains that peerId's
# dial and reservation outcomes, ICE candidate TYPES, transport states,
# timings, counters and error codes. It never gains message or file content, a
# did:key, a room code, or an ICE candidate address. See docs/spec.md.
#TELEMETRY_ENABLED=

# Bearer token for GET /telemetry/list and GET /telemetry/get, which the
# analysis dashboard reads. Unset makes both answer 404, so a console that is
# not there is never advertised. Use at least 32 random characters: this token
# reads every bundle every user uploaded.
#TELEMETRY_ADMIN_TOKEN=

# Where bundles are stored. Defaults to /app/data/telemetry, inside the relay's
# own data volume. Point it outside the volume and bundles do not survive a
# redeploy.
#TELEMETRY_DIR=

# The SFU's half. "1" answers a client's ms:diag with a live snapshot of the
# room, and prints one [sfu-telemetry] JSON line per room per 10s sweep to the
# SFU container log. Unset leaves both inert.
#SFU_TELEMETRY=

# Floor between one peer's ms:diag requests, in milliseconds. Default 10000.
# Each request calls getStats() on every transport, producer and consumer that
# peer holds, one worker round-trip each, so too low a value lets one client
# make the worker sample continuously.
#SFU_DIAG_MIN_INTERVAL_MS=

# ── Web Push (on by default) ─────────────────────────────────────────────────

# A phone's app is closed most of the day. DMs reach it through the relay's
# offline mailbox, and without this nothing wakes it: the message sits there
# until the user happens to open the app.
#
# The push carries no content. Its entire payload is {"t":"mail"} - "check
# your box" - at most one per box per minute, and one per device until that
# device collects or an hour passes. Everything real stays sealed in the
# mailbox blob the device collects once it is awake.
#
# What it does disclose: for each subscribed device the relay stores a push
# endpoint at a push vendor (Google, Mozilla, Apple), which is a stable
# per-device identifier at that third party, and the vendor sees every
# wake-up. Subscribing is per device and opt-in in the app.
#
# "0" turns the whole surface off: /push/config answers enabled:false and the
# subscribe routes 404. Anything else, including unset, leaves it on.
#PUSH_ENABLED=

# mailto: contact put in the VAPID header, which is how a push vendor reaches
# the operator of a misbehaving instance. Defaults to mailto:admin@DOMAIN.
#PUSH_CONTACT=mailto:admin@example.com

# Push services the relay will send to, comma-separated; "*.example.com"
# matches any subdomain. Unset means the services browsers use today:
# fcm.googleapis.com (Chrome, Android, Samsung, Opera, Brave),
# updates.push.services.mozilla.com (Firefox), web.push.apple.com and
# *.push.apple.com (Safari), *.notify.windows.com (Edge on Windows). Setting
# it REPLACES that list. "*" allows any https host, which lets whoever
# subscribes point the relay's requests at any server they like.
#PUSH_ALLOWED_HOSTS=

# ── Capacity ─────────────────────────────────────────────────────────────────

# SFU WebRTC media ports. ONE pair: it sets both the range mediasoup allocates
# from and the range docker publishes, so they cannot drift apart. Open it in
# the firewall (udp and tcp). Roughly one port per participant per stream.
#
# IMPORTANT: The range MUST stay above 60999. Linux ephemeral ports are
# 32768-60999 by default, and docker binds every port when the container starts.
# If any port is already in use, the whole SFU fails to start. A range inside
# the ephemeral window makes startup fail randomly, especially after reboots.
# See deploy/README.md for the multi-server SFU satellite case and the docker
# daemon.json userland-proxy setting.
#SFU_RTC_MIN_PORT=61000
#SFU_RTC_MAX_PORT=61499

# Maximum rooms holding a mediasoup router on one SFU. Counts ROOMS, not
# participants - the port range above is the real ceiling. mediasoup keeps
# separate udp and tcp pools, so an N-port range allows N transports and a
# participant in a call holds two (send + recv): 500 ports is about 250
# concurrent participants. Raise both together or neither.
#SFU_MAX_ROOMS=250

# How long to wait for an incumbent session to answer a liveness probe before
# allowing a duplicate join to take its slot. Long enough that a browser on a
# working connection always answers without waking the page. Short enough that
# a real reconnect after losing a network (wifi to cellular mid-call, losing
# the socket without a FIN) is not left staring at dead video.
#SFU_REJOIN_PROBE_MS=3000

# Extra origins a browser's SFU signalling socket may come from, besides
# https://DOMAIN, comma-separated. A page on any other origin is refused at
# the upgrade. Unset with DOMAIN unset and NODE_ENV not production (the local
# dev stack) accepts any origin.
#SFU_ALLOWED_ORIGINS=

# Signalling sockets that have not joined a room yet, per client address
# (IPv6 per /64), per proxy that did not say which client it carries, and in
# total. Each may wait 10 seconds to join. The SFU believes X-Forwarded-For
# from SFU_TRUSTED_PROXY_CIDRS, by default loopback and the private ranges,
# which is only the instance's own proxy on the compose's private network.
#SFU_MAX_PENDING_PER_IP=8
#SFU_MAX_PENDING_PER_PROXY=256
#SFU_MAX_PENDING=1024
#SFU_TRUSTED_PROXY_CIDRS=

# coturn relay ports - one per TURN allocation, so this is the ceiling on
# concurrent relayed peers. The old 100-port default was reachable by a few
# dozen users, and past it calls do not degrade, they fail.
#TURN_MIN_PORT=49152
#TURN_MAX_PORT=50151

# Concurrent TURN allocations for the whole server. A browser holds about two
# per peer connection for each TURN server it is offered. Keep it inside the
# port range above, and at least ten times what one address can hold (below).
#TURN_TOTAL_QUOTA=900

# Allocations per credential. Every credential the relay mints has a username
# of its own, and the relay hands one address at most seven live credentials
# (25 per IPv6 /48), so one address holds at most seven times this: 84 of the
# 900 by default, which takes about eleven addresses to fill.
#TURN_USER_QUOTA=12

# ── Optional pages ───────────────────────────────────────────────────────────

# /qs - send a file to one person, no account and no room. The code is the
# only secret; bytes go peer to peer and are never stored on the server.
#USE_QS=true

# /qc - a call with no room and no account.
#USE_QC=true

# ── What's new ───────────────────────────────────────────────────────────────

# Settings > What's new lists the last five pull requests merged into main.
# The frontend container fetches them from GitHub's API when it starts and
# serves its own copy; users' browsers never contact GitHub. 0 turns it off.
#WHATS_NEW=0
